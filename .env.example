# .env          ← dans .gitignore ✅ — valeurs réelles
DAGSHUB_USERNAME=monuser
DAGSHUB_TOKEN=abc123secret
DAGSHUB_REPO=Supply-Chain-MLOps

COMPOSE_PROJECT_NAME=mlopsv
COMPOSE_FILE=docker-compose.yml:docker-compose.airflow.yml

############## pour usage nginx et
export AIRFLOW_UID=1000
export AIRFLOW_GID=0
API_HOST=172.31.37.17
AIRFLOW_HOST=172.31.44.53
export DOCKFLD=dockers/slim/

# Ports
API_PORT=8000
AIRFLOW_PORT=8080

# Projet
COMPOSE_PROJECT_NAME=pr007
API_VERSION=1.0.0
#cpu ou gpu
BACKEND=cpu

#config airflow mais à mettre sur le serveur NGINX !!!
AIRFLOW_BIND_IP=$AIRFLOW_HOST #docker dit écouter uniquement sur l'interface réseau de la machine Airflow 
AIRFLOW_BIND_IP=0.0.0.0      #pour poste en local qui peut tour lancer

AIRFLOW__WEBSERVER__BASE_URL=https://LIORA-VM-77GI/airflow-proxy
AIRFLOW__WEBSERVER__BASE_URL=https://airflow.mondomaine.com
AIRFLOW__WEBSERVER__BASE_URL=

AIRFLOW__WEBSERVER__ENABLE_PROXY_FIX=True  # ← obligatoire derrière un reverse proxy

#grafana
GF_ANALYTICS_REPORTING_ENABLED=false
GF_ANALYTICS_CHECK_FOR_UPDATES=false