# Copy to .env.docker.local (already ignored by .gitignore).
# Compose reads these credentials at runtime; never put them in Docker build args.
MLFLOW_TRACKING_USERNAME=
DAGSHUB_USER_TOKEN=
# Alternatively replace DAGSHUB_USER_TOKEN with MLFLOW_TRACKING_PASSWORD.
# MLFLOW_TRACKING_PASSWORD=
# Default tracking URI comes from the verified Docker selection.
# Optional explicit override (credentials must remain separate):
# SUPPLY_CHAIN_TRACKING_URI=https://dagshub.com/mom.robin.63/Supply-Chain-MLOps.mlflow
# Select a host file using the shell or Compose --env-file (see README):
# SUPPLY_CHAIN_SELECTION_FILE=./config/selection.docker.json
# SUPPLY_CHAIN_SELECTION_PATH=/app/config/selection.json
# HF_HUB_OFFLINE=0
