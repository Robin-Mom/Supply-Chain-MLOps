# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv
.ml

# --- CONFIGURATION DATA (GIT + DVC) ---
# On ignore le contenu du dossier data
data/*
# Sauf les fichiers de configuration et de tracking DVC
!data/.gitkeep
!data/*.dvc
!data/.gitignore

# --- CONFIGURATION MODELS ---
models/*
!models/.gitkeep
# Si tu utilises DVC pour les modèles aussi :
!models/*.dvc

# IDE & Config
.vscode/
!.vscode/settings.json
.env
.streamlit/secrets.toml

# Logs du pipeline (On ne les push pas sur Git)
logs/