{
  "id": null,
  "uid": "supply-chain-model",
  "title": "Model Serving Health",
  "description": "Selected model serving availability and POST /predict HTTP operations. Operational metrics only: no model quality or data drift claims.",
  "tags": [
    "supply-chain",
    "mlops",
    "serving"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "refresh": "15s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "timepicker": {},
  "templating": {
    "list": []
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "title": "Selected model readiness",
      "type": "stat",
      "description": "Current scraped state. Missing data is not interpreted as healthy or as zero.",
      "datasource": {
        "type": "prometheus",
        "uid": "supply-chain-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "supply-chain-prometheus"
          },
          "expr": "model_ready{job=\"fastapi\"}",
          "legendFormat": "Selected model readiness",
          "refId": "A",
          "range": false,
          "editorMode": "code",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "noValue": "No samples",
          "min": 0,
          "color": {
            "mode": "thresholds"
          },
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "UNAVAILABLE",
                  "color": "red"
                },
                "1": {
                  "text": "READY",
                  "color": "green"
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto",
        "justifyMode": "auto"
      }
    },
    {
      "id": 2,
      "title": "FastAPI scrape target",
      "type": "stat",
      "description": "Current scraped state. Missing data is not interpreted as healthy or as zero.",
      "datasource": {
        "type": "prometheus",
        "uid": "supply-chain-prometheus"
      },
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "supply-chain-prometheus"
          },
          "expr": "up{job=\"fastapi\"}",
          "legendFormat": "FastAPI scrape target",
          "refId": "A",
          "range": false,
          "editorMode": "code",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "noValue": "No samples",
          "min": 0,
          "color": {
            "mode": "thresholds"
          },
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "DOWN",
                  "color": "red"
                },
                "1": {
                  "text": "UP",
                  "color": "green"
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto",
        "justifyMode": "auto"
      }
    },
    {
      "id": 3,
      "title": "Prediction requests · process lifetime",
      "type": "stat",
      "description": "Cumulative POST /predict HTTP requests across all statuses, not individual reviews or successful predictions. Resets on API restart.",
      "datasource": {
        "type": "prometheus",
        "uid": "supply-chain-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "supply-chain-prometheus"
          },
          "expr": "sum(http_requests_total{job=\"fastapi\",route=\"/predict\",method=\"POST\"})",
          "legendFormat": "Prediction requests",
          "refId": "A",
          "range": false,
          "editorMode": "code",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "No samples",
          "min": 0,
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto",
        "justifyMode": "auto"
      }
    },
    {
      "id": 4,
      "title": "Inference HTTP error fraction · 4xx + 5xx",
      "type": "stat",
      "description": "POST /predict error rate divided by its total rate. Includes validation errors. No traffic produces no value; no proxy errors included.",
      "datasource": {
        "type": "prometheus",
        "uid": "supply-chain-prometheus"
      },
      "gridPos": {
        "x": 18,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "supply-chain-prometheus"
          },
          "expr": "((sum(rate(http_requests_total{job=\"fastapi\",route=\"/predict\",method=\"POST\",status_code=~\"4..|5..\"}[$__rate_interval])) or (0 * sum(rate(http_requests_total{job=\"fastapi\",route=\"/predict\",method=\"POST\"}[$__rate_interval])))) / sum(rate(http_requests_total{job=\"fastapi\",route=\"/predict\",method=\"POST\"}[$__rate_interval]))) and (sum(rate(http_requests_total{job=\"fastapi\",route=\"/predict\",method=\"POST\"}[$__rate_interval])) > 0)",
          "legendFormat": "Error fraction",
          "refId": "A",
          "range": false,
          "editorMode": "code",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "noValue": "No samples",
          "min": 0,
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto",
        "justifyMode": "auto"
      }
    },
    {
      "id": 5,
      "title": "Inference HTTP request rate",
      "type": "timeseries",
      "description": "POST /predict requests per second, all statuses. Does not count the number of reviews within a batch.",
      "datasource": {
        "type": "prometheus",
        "uid": "supply-chain-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "supply-chain-prometheus"
          },
          "expr": "sum(rate(http_requests_total{job=\"fastapi\",route=\"/predict\",method=\"POST\"}[$__rate_interval]))",
          "legendFormat": "POST /predict",
          "refId": "A",
          "range": true,
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "noValue": "No samples",
          "min": 0,
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 6,
      "title": "HTTP request duration · p50 / p95 / p99",
      "type": "timeseries",
      "description": "Complete HTTP duration including preprocessing, encoder, estimator, queueing and response handling. Not pure model computation time. No observations produce gaps, not zero latency.",
      "datasource": {
        "type": "prometheus",
        "uid": "supply-chain-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "supply-chain-prometheus"
          },
          "expr": "histogram_quantile(0.5, sum by (le) (rate(http_request_duration_seconds_bucket{job=\"fastapi\",route=\"/predict\",method=\"POST\"}[$__rate_interval])))",
          "legendFormat": "p50",
          "refId": "A",
          "range": true,
          "editorMode": "code"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "supply-chain-prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (le) (rate(http_request_duration_seconds_bucket{job=\"fastapi\",route=\"/predict\",method=\"POST\"}[$__rate_interval])))",
          "legendFormat": "p95",
          "refId": "B",
          "range": true,
          "editorMode": "code"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "supply-chain-prometheus"
          },
          "expr": "histogram_quantile(0.99, sum by (le) (rate(http_request_duration_seconds_bucket{job=\"fastapi\",route=\"/predict\",method=\"POST\"}[$__rate_interval])))",
          "legendFormat": "p99",
          "refId": "C",
          "range": true,
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "noValue": "No samples",
          "min": 0,
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    }
  ],
  "links": [
    {
      "title": "API Performance",
      "type": "link",
      "url": "/d/supply-chain-api"
    },
    {
      "title": "Model Serving Health",
      "type": "link",
      "url": "/d/supply-chain-model"
    }
  ]
}
