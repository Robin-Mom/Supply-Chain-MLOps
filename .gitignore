# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv
.ml

# --- CONFIGURATION DATA (GIT + DVC) ---
# On ignore le contenu du dossier data
data/*
# Sauf les fichiers de configuration et de tracking DVC
!data/.gitkeep
!data/*.dvc
!data/.gitignore

# --- CONFIGURATION MODELS ---
models/*
!models/.gitkeep
# Si tu utilises DVC pour les modèles aussi :
!models/*.dvc

# IDE & Config
.vscode/
!.vscode/settings.json
.env
.streamlit/secrets.toml

# Logs du pipeline (On ne les push pas sur Git)
logs/

# --- DVC LOCAL CONFIGURATION (SÉCURITÉ) ---
.dvc/config.local
.dvc/cache/
.dvc/tmp/
.dvc/config*


# ======================
# Nginx - Certificats SSL
# ======================
#dockers/nginx/certs/
# ou plus fin si tu veux garder le dossier vide dans git
dockers/nginx/certs/*.key
dockers/nginx/certs/*.crt
dockers/nginx/certs/*.csr
dockers/nginx/certs/*.srl
dockers/nginx/certs/*.pem

# ======================
# Nginx - Authentification
# ======================
dockers/nginx/.htpasswd
dockers/nginx/.htpasswd.*.DS_Store
.DS_Store
**/.DS_Store


# ======================
# data disk usage collection
# ======================
ddu/*